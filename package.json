{
  "name": "scientist-calendar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "vite build --config tooling/pages/vite.config.ts",
    "start": "vinext start",
    "test": "npm run build && node --test tooling/tests/rendered-html.test.mjs",
    "lint": "eslint . --config tooling/eslint.config.mjs --ignore-pattern dist --ignore-pattern .next",
    "audit:data": "python -X utf8 tooling/scripts/audit_data.py",
    "verify:dates": "python -X utf8 tooling/scripts/verify_dates.py",
    "verify:facts": "python -X utf8 tooling/scripts/verify_facts.py",
    "verify:pdf": "python -X utf8 tooling/scripts/verify_pdf_layout.py",
    "pdf:daily": "python -X utf8 tooling/scripts/generate_print_calendar.py",
    "pdf:monthly": "python -X utf8 tooling/scripts/generate_monthly_calendar.py"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
