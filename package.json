{
  "name": "scientist-calendar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "vite build --config tooling/pages/vite.config.ts",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "test": "npm run build && node --test tooling/tests/rendered-html.test.mjs",
    "lint": "eslint . --config tooling/eslint.config.mjs --ignore-pattern dist --ignore-pattern .next",
    "audit:data": "python -X utf8 tooling/scripts/audit_data.py",
    "build:web-data": "python -X utf8 tooling/scripts/build_web_data.py",
    "check:web-data": "python -X utf8 tooling/scripts/build_web_data.py --check",
    "verify:dates": "python -X utf8 tooling/scripts/verify_dates.py",
    "verify:facts": "python -X utf8 tooling/scripts/verify_facts.py",
    "verify:pdf": "python -X utf8 tooling/scripts/verify_pdf_layout.py",
    "pdf:daily": "python -X utf8 tooling/scripts/generate_print_calendar.py",
    "pdf:monthly": "python -X utf8 tooling/scripts/generate_monthly_calendar.py"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "type": "module"
}
